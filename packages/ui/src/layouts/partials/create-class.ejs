<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <h5 class="card-title">Tạo lớp học mới</h5>
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        <form action="/classroom/classes/create" method="POST">
                            <div class="form-group mb-3">
                                <!-- Môn -->
                                <label for="course" class="form-label form-required">Môn học</label>
                                <select name="course" id="course" class="form-select">
                                    <% courseList?.forEach(course=> { %>
                                        <option value="<%= course.id %>"
                                            <% if (locals?.courseId && course.id == locals?.courseId) { %> selected <% } %>>
                                            <%= course.courseName %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <!-- Nhóm -->
                            <div class="form-group mb-3">
                                <label for="group" class="form-label form-required">Nhóm</label>
                                <input type="number" class="form-control" id="group" name="group" placeholder="Nhóm"
                                    value="<%= locals?.group || '' %>"
                                    min="1" required />
                            </div>
                            <!-- Giảng viên -->
                            <div class="form-group mb-3">
                                <label for="teacher" class="form-label form-required">Giảng viên</label>
                                <select name="teacher" id="teacher" class="form-select">
                                    <% teacherList?.forEach(teacher=> { %>
                                        <option value="<%= teacher.id %>">
                                            <%= teacher.firstName + ' ' + teacher.lastName %>
                                            <% if (locals?.teacherId && teacher.id == locals?.teacherId) { %>
                                                selected
                                                <% } %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>
                            <!-- Học kì -->
                            <div class="form-group mb-3">
                                <label for="semester" class="form-label form-required">Học kì</label>
                                <select name="semester" id="semester" class="form-select">
                                    <% for (let i=0; i< semesterList?.length; i++) { %>
                                        <option value="<%= semesterList[i] %>" 
                                            <% if (locals?.semester && semesterList[i] == locals?.semester) { %>
                                                selected
                                                <% } %>>
                                            <%= semesterList[i] %>
                                        </option>
                                        <% } %>
                                </select>
                            </div>
                            <!-- Số lượng sinh viên -->
                            <div class="form-group mb-3">
                                <label for="maxStudent" class="form-label form-required">Số lượng sinh viên tối
                                    đa</label>
                                <input type="number" class="form-control" id="maxStudent" name="maxStudent"
                                    placeholder="Số lượng sinh viên tối đa" 
                                    value="<%= locals?.maxStudent || '' %>"
                                    min="1" required />
                            </div>
                            <!-- Số buổi -->
                            <div class="form-group mb-3">
                                <label for="numberOfSessions" class="form-label form-required">Số buổi</label>
                                <input type="number" class="form-control" id="numberOfSessions" name="numberOfSessions"
                                    placeholder="Số buổi" 
                                    value="<%= locals?.numberOfSessions || '' %>"
                                    required />
                            </div>
                            <!-- Lịch học -->
                            <div class="form-group mb-3">
                                <label for="schedule" class="form-label form-required">Lịch học</label>
                                <div id="schedule-list">
                                    <!-- Dòng mẫu sẽ bị clone -->
                                    <div class="schedule-item mb-3" data-index="0">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="form-label">Ngày</label>
                                                <select class="form-select" name="schedules[0][day]">
                                                    <option value="Thứ 2">Thứ 2</option>
                                                    <option value="Thứ 3">Thứ 3</option>
                                                    <option value="Thứ 4">Thứ 4</option>
                                                    <option value="Thứ 5">Thứ 5</option>
                                                    <option value="Thứ 6">Thứ 6</option>
                                                    <option value="Thứ 7">Thứ 7</option>
                                                    <option value="Chủ nhật">Chủ nhật</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Giờ bắt đầu</label>
                                                <input type="time" class="form-control" name="schedules[0][startTime]"
                                                    required>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label">Giờ kết thúc</label>
                                                <input type="time" class="form-control" name="schedules[0][endTime]"
                                                    required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-secondary mt-2" onclick="addSchedule()">Thêm lịch
                                    học</button>

                            </div>
                            <!-- Nơi hiển thị lỗi -->
                             <div class="form-text text-danger">
                                <% if(locals.errorValidator && locals.errorValidator.group ){%>
                                    <div class="text-danger d-flex justify-content-center h5">
                                       <%= locals.errorValidator.group %>
                                    </div>
                                <%}%>
                            </div>
                            <!-- Submit -->
                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary">Tạo lớp học</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    function addSchedule() {
        const list = document.getElementById('schedule-list');
        const items = list.querySelectorAll('.schedule-item');
        const newIndex = items.length;

        const newItem = items[0].cloneNode(true);

        newItem.setAttribute('data-index', newIndex);

        // Update name attributes
        newItem.querySelectorAll('select, input').forEach(input => {
            if (input.name.includes('[day]')) {
                input.name = `schedules[${newIndex}][day]`;
            } else if (input.name.includes('[startTime]')) {
                input.name = `schedules[${newIndex}][startTime]`;
            } else if (input.name.includes('[endTime]')) {
                input.name = `schedules[${newIndex}][endTime]`;
            }
            input.value = ''; // reset value
        });

        list.appendChild(newItem);
    }
</script>